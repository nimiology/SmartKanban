# ---------- Core ----------
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
KANBAN_DB_PASSWORD=
PORT=3001
ATTACHMENTS_DIR=./data/attachments
COOKIE_SECRET=change-me-to-a-long-random-string

# Account registration is enabled by default for first-run setup.
# Set to "false" to disable all new account creation, including bootstrap.
OPEN_SIGNUP=true

# ---------- Telegram ----------
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Group chat ID (find via @userinfobot while the bot is in the group, or
# log a message at bot startup). Without this, the bot will ignore everything.
TELEGRAM_GROUP_ID=

# Public HTTPS URL the bot posts updates to. If unset the server falls back to
# long polling (fine for local dev).
#   Webhook path: /telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook
# Optional public bot username; also discovered from Telegram when the bot starts.
TELEGRAM_BOT_USERNAME=

# ---------- OpenAI ----------
# Chat, vision, Whisper voice transcription, and optional embeddings.
# Without this key, text proposals are unavailable; voice and image captures
# are saved for review instead of being summarized.
OPENAI_API_KEY=

# Public base URL (used for secure cookies and public links).
APP_URL=https://kanban.zeydi.site

# Admin / Google OAuth (admin-role build)

# Admin
ADMIN_EMAILS=

# Google OAuth (disabling these makes /api/auth/google/* return 503)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PUBLIC_APP_URL=
MACOS_URL_SCHEME=kanbanclaude
